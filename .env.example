# Required only for voice input through the Sarvam adapter.
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v3
SARVAM_MODE=codemix
SARVAM_LANGUAGE_CODE=unknown

# Optional hosted answer generation. The default is grounded extractive mode,
# which is local and is the mode used for the latency target.
ANSWER_MODE=extractive
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

INDEX_DIR=artifacts/index
EMBEDDER=hash
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_TOP_K=5
RAG_MIN_SCORE=0.18
